{
  "manifest_version": 3,
  "name": "TapStack",
  "version": "1.26.1",
  "description": "保存即关闭：把当前窗口的标签页存成一个会话并关掉它们，随时找回并恢复。",
  "minimum_chrome_version": "120",
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https: http:; font-src 'self' data:; connect-src 'self' https://*.supabase.co https://* http://localhost:* http://127.0.0.1:*; frame-src 'none'; base-uri 'self'; form-action 'self';"
  },
  "permissions": [
    "tabs",
    "storage",
    "notifications",
    "contextMenus",
    "alarms"
  ],
  "host_permissions": [
    "https://*.supabase.co/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "action": {
    "default_icon": "icons/icon16.png",
    "default_title": "TapStack - 打开会话管理器"
  },
  "options_ui": {
    "page": "src/options/index.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "service-worker.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "save_all_tabs": {
      "suggested_key": {
        "default": "Ctrl+Shift+S",
        "mac": "Command+Shift+S"
      },
      "description": "Save all tabs in this window and close them"
    },
    "save_all_tabs_alt": {
      "suggested_key": {
        "default": "Alt+Shift+S",
        "mac": "Alt+Shift+S"
      },
      "description": "Save all tabs and close them"
    },
    "save_current_tab": {
      "suggested_key": {
        "default": "Alt+S",
        "mac": "Alt+S"
      },
      "description": "Save tab and close it"
    }
  }
}
