{
  "name": "tapstack",
  "version": "1.20.0",
  "description": "保存浏览器工作会话，稍后快速找回与恢复",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:dev": "tsc && vite build",
    "build:web": "tsc --noEmit && vite build --config vite.web.config.ts",
    "package": "pnpm build && node package-extension.js",
    "preview": "vite preview",
    "test": "node --test --experimental-strip-types tests/*.test.ts",
    "e2e": "node scripts/run-e2e.mjs",
    "e2e:list": "node scripts/run-e2e.mjs --list",
    "lint": "eslint src --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "security:audit": "pnpm audit --config.registry=https://registry.npmjs.org/",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "type-check": "tsc --noEmit",
    "validate": "node scripts/validate-extension.mjs && pnpm type-check && pnpm lint && pnpm build",
    "test:supabase-smoke": "node scripts/supabase-smoke-test.mjs",
    "supabase:migrate": "node scripts/supabase-migrate.mjs",
    "supabase:migrate:dry-run": "node scripts/supabase-migrate.mjs --dry-run",
    "supabase:verify": "node scripts/supabase-migrate.mjs --verify-only"
  },
  "keywords": [
    "chrome-extension",
    "tab-management",
    "react",
    "typescript"
  ],
  "author": "",
  "license": "MIT",
  "packageManager": "pnpm@10.24.0",
  "dependencies": {
    "@reduxjs/toolkit": "^2.2.1",
    "@supabase/supabase-js": "^2.49.4",
    "clsx": "^2.1.1",
    "dexie": "^4.4.6",
    "lz-string": "^1.5.0",
    "react": "^18.2.0",
    "react-dnd": "^16.0.1",
    "react-dnd-html5-backend": "^16.0.1",
    "react-dom": "^18.2.0",
    "react-redux": "^9.1.0",
    "tailwind-merge": "^3.4.0",
    "y-indexeddb": "^9.0.12",
    "yjs": "^13.6.32"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.7.1",
    "@types/chrome": "^0.0.262",
    "@types/lz-string": "^1.5.0",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^18.2.64",
    "@types/react-dom": "^18.2.21",
    "@typescript-eslint/eslint-plugin": "^7.1.1",
    "@typescript-eslint/parser": "^7.1.1",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.18",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.34.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "pg": "^8.23.0",
    "playwright": "1.61.0",
    "postcss": "^8.5.28",
    "prettier": "^3.2.5",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.4.2",
    "vite": "^6.4.3"
  },
  "pnpm": {
    "overrides": {
      "glob@>=10.2.0 <10.5.0": "10.5.0",
      "minimatch@<3.1.4": "3.1.5",
      "minimatch@>=9.0.0 <9.0.7": "9.0.9",
      "brace-expansion@<1.1.18": "1.1.18",
      "brace-expansion@>=2.0.0 <2.1.4": "2.1.4",
      "js-yaml@>=4.0.0 <4.3.2": "4.3.2",
      "flatted@<3.4.2": "3.4.4",
      "nanoid@<3.3.18": "3.3.19",
      "picomatch@<2.3.2": "2.3.2",
      "ws@>=8.0.0 <8.21.0": "8.21.3",
      "browserslist@<=4.28.6": "4.28.9",
      "rollup@>=3.0.0 <3.30.0": "3.30.0",
      "rollup@<2.80.0": "2.80.0",
      "yaml@>=2.0.0 <2.8.3": "2.9.1",
      "ajv@<6.14.0": "6.15.0",
      "postcss-selector-parser@>=6.1.0 <6.1.3": "6.1.4",
      "@babel/core@<=7.29.0": "7.29.7"
    }
  }
}
